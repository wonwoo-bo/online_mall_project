<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.module.product.mapper.ReviewReportMapper">

    <resultMap id="reviewReportResultMap" type="com.mall.module.product.entity.ReviewReport">
        <id column="id" property="id"/>
        <result column="review_id" property="reviewId"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="reason" property="reason"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO review_report (review_id, merchant_id, reason, description, status, create_time)
        VALUES (#{reviewId}, #{merchantId}, #{reason}, #{description}, #{status}, #{createTime})
    </insert>

    <select id="selectByReviewIdAndMerchantId" resultMap="reviewReportResultMap">
        SELECT * FROM review_report 
        WHERE review_id = #{reviewId} AND merchant_id = #{merchantId}
        ORDER BY create_time DESC LIMIT 1
    </select>

</mapper>
