<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.module.product.mapper.ReviewTopMapper">

    <resultMap id="BaseResultMap" type="com.mall.module.product.entity.ReviewTop">
        <id column="id" property="id"/>
        <result column="review_id" property="reviewId"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="product_id" property="productId"/>
        <result column="top_time" property="topTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO review_top (review_id, merchant_id, product_id)
        VALUES (#{reviewId}, #{merchantId}, #{productId})
    </insert>

    <delete id="delete">
        DELETE FROM review_top WHERE review_id = #{reviewId} AND product_id = #{productId}
    </delete>

    <select id="selectByMerchantId" resultMap="BaseResultMap">
        SELECT * FROM review_top WHERE merchant_id = #{merchantId} ORDER BY top_time DESC
    </select>

</mapper>
