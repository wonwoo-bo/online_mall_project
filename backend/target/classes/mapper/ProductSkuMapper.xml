<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.module.product.mapper.ProductSkuMapper">

    <resultMap id="productSkuResultMap" type="com.mall.module.product.entity.ProductSku">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="sku_code" property="skuCode"/>
        <result column="specs" property="specs"/>
        <result column="price" property="price"/>
        <result column="stock" property="stock"/>
        <result column="sales" property="sales"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByProductId" resultMap="productSkuResultMap">
        SELECT * FROM product_sku WHERE product_id = #{productId} AND status = 1
    </select>

    <select id="selectById" resultMap="productSkuResultMap">
        SELECT * FROM product_sku WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.mall.module.product.entity.ProductSku">
        INSERT INTO product_sku (product_id, sku_code, specs, price, stock, sales, status, create_time)
        VALUES (#{productId}, #{skuCode}, #{specs}, #{price}, #{stock}, #{sales}, #{status}, NOW())
    </insert>

</mapper>
