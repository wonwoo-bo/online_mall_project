<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.module.product.mapper.ReviewImageMapper">

    <resultMap id="reviewImageResultMap" type="com.mall.module.product.entity.ReviewImage">
        <id column="id" property="id"/>
        <result column="review_id" property="reviewId"/>
        <result column="image_url" property="imageUrl"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByReviewId" resultMap="reviewImageResultMap">
        SELECT * FROM review_image WHERE review_id = #{reviewId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO review_image (review_id, image_url, create_time)
        VALUES (#{reviewId}, #{imageUrl}, #{createTime})
    </insert>

    <delete id="deleteByReviewId">
        DELETE FROM review_image WHERE review_id = #{reviewId}
    </delete>

</mapper>
