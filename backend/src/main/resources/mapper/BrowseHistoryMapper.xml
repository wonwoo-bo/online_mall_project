<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.module.product.mapper.BrowseHistoryMapper">

    <resultMap id="browseHistoryResultMap" type="com.mall.module.product.entity.BrowseHistory">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="browse_time" property="browseTime"/>
    </resultMap>

    <select id="selectByUserId" resultMap="browseHistoryResultMap">
        SELECT * FROM browse_history WHERE user_id = #{userId} ORDER BY browse_time DESC LIMIT #{offset}, #{limit}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO browse_history (user_id, product_id, browse_time)
        VALUES (#{userId}, #{productId}, #{browseTime})
    </insert>

    <delete id="deleteById">
        DELETE FROM browse_history WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM browse_history WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByUserIdAndProductId">
        DELETE FROM browse_history WHERE user_id = #{userId} AND product_id = #{productId}
    </delete>

</mapper>
