<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.module.admin.mapper.AdminMapper">

    <resultMap id="AdminResultMap" type="com.mall.module.admin.entity.Admin">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="salt" column="salt"/>
        <result property="nickname" column="nickname"/>
        <result property="phone" column="phone"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="findByUsername" resultMap="AdminResultMap">
        SELECT * FROM admin WHERE username = #{username}
    </select>

    <select id="findById" resultMap="AdminResultMap">
        SELECT * FROM admin WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="AdminResultMap">
        SELECT * FROM admin ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="com.mall.module.admin.entity.Admin">
        INSERT INTO admin (username, password, salt, nickname, phone, status, create_time, update_time)
        VALUES (#{username}, #{password}, #{salt}, #{nickname}, #{phone}, #{status}, #{createTime}, #{updateTime})
    </insert>

    <update id="update" parameterType="com.mall.module.admin.entity.Admin">
        UPDATE admin SET
            password = #{password},
            salt = #{salt},
            nickname = #{nickname},
            phone = #{phone},
            status = #{status},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM admin WHERE id = #{id}
    </delete>

</mapper>